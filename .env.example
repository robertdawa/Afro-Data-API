# Copy to .env and adjust. `.env` is git-ignored — never commit it.
# Values below are for LOCAL DEVELOPMENT ONLY.
#
# These URLs point at localhost so you can run the backend outside Docker.
# Inside `docker compose`, the backend's hostnames are overridden to the
# service names (postgres, redis, minio) — see infra/docker-compose.yml.

# --- App -------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=adp
POSTGRES_PASSWORD=adp
POSTGRES_DB=adp
DATABASE_URL=postgresql+psycopg://adp:adp@localhost:5432/adp

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, any S3-compatible store in prod) --------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_RAW=adp-raw
S3_BUCKET_EXPORTS=adp-exports

# --- Security --------------------------------------------------------------
# Server-side secret mixed into API key hashes. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in staging/production with the default value.
API_KEY_HASH_SECRET=dev-only-change-me

# --- AI (Phase 6) ----------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Frontend --------------------------------------------------------------
# Browser-facing API URL (used by client-side code).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side API URL used by Next.js server components.
API_INTERNAL_URL=http://localhost:8000
